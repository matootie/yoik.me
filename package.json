{
  "name": "yoikme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*",
    "services/*",
    "functions"
  ],
  "lint-staged": {
    "*": "prettier --write --ignore-unknown --config config/.prettierrc.json"
  },
  "scripts": {
    "client": "bun run --filter @yme/client",
    "develop": "turbo run develop --no-cache --parallel --continue",
    "api": "bun run --filter @yme/api",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @yme/e2e test:e2e",
    "test:e2e:production": "bun run --filter @yme/e2e test:e2e:production"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.11"
  }
}
